{
  "name": "subconverter-ts",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "TypeScript rewrite of subconverter: an isomorphic subscription converter for Node.js, the browser, and the CLI.",
  "license": "GPL-3.0",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/core",
    "packages/node",
    "packages/browser",
    "packages/cli"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "lint:fix": "npm run lint:fix --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nx/eslint-plugin": "^23.2.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.4",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-perfectionist": "^5.12.1",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.13.0",
    "knip": "^5.71.0",
    "nx": "^23.2.1",
    "prettier": "^3.9.9",
    "tsup": "^8.5.0",
    "tsx": "^4.20.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3",
    "@vitest/coverage-v8": "^5.0.3"
  }
}
