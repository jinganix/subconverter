{
  "name": "@subconverter/browser",
  "version": "0.1.0",
  "description": "Browser build of subconverter-ts: an in-page subscription converter.",
  "license": "GPL-3.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/subconverter.global.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./global": "./dist/subconverter.global.js"
  },
  "files": [
    "dist"
  ],
  "nx": {
    "tags": [
      "scope:browser",
      "type:lib"
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "npm run typecheck:tsc && npm run lint",
    "typecheck:tsc": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "eslint src \"*.ts\" --no-error-on-unmatched-pattern --max-warnings 0",
    "lint:fix": "eslint src \"*.ts\" --no-error-on-unmatched-pattern --fix",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@subconverter/core": "0.1.0"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
