{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "@subconverter/cli",
  "projectType": "application",
  "sourceRoot": "packages/cli/src",
  "tags": ["scope:cli", "type:app"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": { "command": "npm run build", "cwd": "packages/cli" },
      "outputs": ["{projectRoot}/dist"]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": { "command": "npm test", "cwd": "packages/cli" }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": { "command": "npm run typecheck", "cwd": "packages/cli" }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": { "command": "npm run lint", "cwd": "packages/cli" }
    }
  }
}
