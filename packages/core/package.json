{
  "name": "@subconverter/core",
  "version": "0.2.1",
  "description": "Isomorphic subscription conversion engine for subconverter-ts.",
  "keywords": [
    "subconverter",
    "subscription",
    "clash",
    "surge",
    "quantumultx",
    "loon",
    "sing-box",
    "proxy",
    "parser",
    "converter",
    "isomorphic",
    "typescript"
  ],
  "homepage": "https://github.com/jinganix/subconverter#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jinganix/subconverter.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/jinganix/subconverter/issues"
  },
  "license": "GPL-3.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "nx": {
    "tags": [
      "scope:core",
      "type:lib"
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "npm run typecheck:tsc && npm run lint",
    "typecheck:tsc": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "eslint src tests \"*.ts\" .prettierrc.* eslint.config.js --no-error-on-unmatched-pattern --max-warnings 0",
    "lint:fix": "eslint src tests \"*.ts\" .prettierrc.* eslint.config.js --no-error-on-unmatched-pattern --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
