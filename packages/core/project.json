{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "@subconverter/core",
  "projectType": "library",
  "sourceRoot": "packages/core/src",
  "tags": ["scope:core", "type:lib"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": { "command": "npm run build", "cwd": "packages/core" },
      "outputs": ["{projectRoot}/dist"]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": { "command": "npm test", "cwd": "packages/core" }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": { "command": "npm run typecheck", "cwd": "packages/core" }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": { "command": "npm run lint", "cwd": "packages/core" }
    }
  }
}
