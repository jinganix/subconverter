{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "@subconverter/node",
  "projectType": "library",
  "sourceRoot": "packages/node/src",
  "tags": ["scope:node", "type:lib"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": { "command": "npm run build", "cwd": "packages/node" },
      "outputs": ["{projectRoot}/dist"]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": { "command": "npm test", "cwd": "packages/node" }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": { "command": "npm run typecheck", "cwd": "packages/node" }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": { "command": "npm run lint", "cwd": "packages/node" }
    }
  }
}
