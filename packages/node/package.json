{
  "name": "@subconverter/node",
  "version": "0.2.1",
  "description": "Node.js adapter for subconverter-ts: filesystem, fetch, and config loading.",
  "keywords": [
    "subconverter",
    "subscription",
    "clash",
    "surge",
    "proxy",
    "converter",
    "node",
    "geoip",
    "maxmind",
    "typescript"
  ],
  "homepage": "https://github.com/jinganix/subconverter#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jinganix/subconverter.git",
    "directory": "packages/node"
  },
  "bugs": {
    "url": "https://github.com/jinganix/subconverter/issues"
  },
  "license": "GPL-3.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "nx": {
    "tags": [
      "scope:node",
      "type:lib"
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "npm run typecheck:tsc && npm run lint",
    "typecheck:tsc": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "eslint src \"*.ts\" --no-error-on-unmatched-pattern --max-warnings 0",
    "lint:fix": "eslint src \"*.ts\" --no-error-on-unmatched-pattern --fix",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@subconverter/core": "0.2.1",
    "maxmind": "^5.0.7"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
